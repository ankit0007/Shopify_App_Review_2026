APP_NAME="Shopify Review"
NODE_ENV=development
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://productreviews.it3.in
SHOPIFY_API_VERSION=2026-01
SCOPES=read_products,read_orders,read_customers
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopify_review
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-32-byte-base64-key
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_ENDPOINT=
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_API_URL=
EMAIL_FROM=
EMAIL_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-string
SMTP_MAX_RETRIES=3
SMTP_ALLOW_INSECURE=false
# Used only by `npm run admin:create`. Do not leave the password in a committed file.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_APP_ID=
SHOPIFY_PLAN_STARTER_PRICE=
SHOPIFY_PLAN_GROWTH_PRICE=
SHOPIFY_PLAN_PRO_PRICE=
