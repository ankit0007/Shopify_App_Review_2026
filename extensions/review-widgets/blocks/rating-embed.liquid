{% if block.settings.enabled %}
  <div
    class="shopify-review-rating-source"
    data-rating-source
    data-page-type="{{ request.page_type }}"
    data-click="{% if block.settings.click_to_reviews %}true{% else %}false{% endif %}"
    data-show-count="{% if block.settings.show_count %}true{% else %}false{% endif %}"
    data-count-format="{{ block.settings.count_format | escape }}"
    data-precision="{{ block.settings.precision | default: '1' | escape }}"
    data-empty-text="{{ block.settings.empty_text | escape }}"
    data-write-text="{{ block.settings.write_text | escape }}"
    data-star="{{ block.settings.star_color }}"
    data-empty="{{ block.settings.empty_star_color }}"
    data-star-size="{{ block.settings.star_size }}"
    data-text-size="{{ block.settings.text_size }}"
    data-space="{{ block.settings.spacing }}"
    data-align="{{ block.settings.alignment | escape }}"
  >
    {% case request.page_type %}
      {% when 'collection' %}
        {% for product in collection.products %}
          {% render 'product-rating',
            product: product,
            placement: 'embed',
            hidden: true,
            star_color: block.settings.star_color,
            empty_color: block.settings.empty_star_color,
            star_size: block.settings.star_size,
            text_size: block.settings.text_size,
            show_count: block.settings.show_count,
            count_format: block.settings.count_format,
            precision: block.settings.precision,
            alignment: block.settings.alignment,
            spacing: block.settings.spacing,
            click_to_reviews: block.settings.click_to_reviews,
            empty_text: block.settings.empty_text,
            write_text: block.settings.write_text
          %}
        {% endfor %}
      {% when 'search' %}
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-rating',
              product: item,
              placement: 'embed',
              hidden: true,
              star_color: block.settings.star_color,
              empty_color: block.settings.empty_star_color,
              star_size: block.settings.star_size,
              text_size: block.settings.text_size,
              show_count: block.settings.show_count,
              count_format: block.settings.count_format,
              precision: block.settings.precision,
              alignment: block.settings.alignment,
              spacing: block.settings.spacing,
              click_to_reviews: block.settings.click_to_reviews,
              empty_text: block.settings.empty_text,
              write_text: block.settings.write_text
            %}
          {% endif %}
        {% endfor %}
      {% when 'product' %}
        {% render 'product-rating',
          product: product,
          placement: 'embed',
          hidden: true,
          star_color: block.settings.star_color,
          empty_color: block.settings.empty_star_color,
          star_size: block.settings.star_size,
          text_size: block.settings.text_size,
          show_count: block.settings.show_count,
          count_format: block.settings.count_format,
          precision: block.settings.precision,
          alignment: block.settings.alignment,
          spacing: block.settings.spacing,
          click_to_reviews: block.settings.click_to_reviews,
          empty_text: block.settings.empty_text,
          write_text: block.settings.write_text
        %}
    {% endcase %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product ratings",
  "target": "body",
  "javascript": "product-rating.js",
  "stylesheet": "review-widgets.css",
  "settings": [
    {"type": "checkbox", "id": "enabled", "label": "Show rating", "default": true},
    {"type": "color", "id": "star_color", "label": "Star color", "default": "#f5b301"},
    {"type": "color", "id": "empty_star_color", "label": "Empty star color", "default": "#c5c5c5"},
    {"type": "range", "id": "star_size", "label": "Star size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16},
    {"type": "range", "id": "text_size", "label": "Rating text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14},
    {"type": "checkbox", "id": "show_count", "label": "Show review count", "default": true},
    {"type": "select", "id": "precision", "label": "Rating precision", "default": "1", "options": [{"value": "1", "label": "One decimal"}]},
    {"type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}]},
    {"type": "range", "id": "spacing", "label": "Spacing", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8},
    {"type": "checkbox", "id": "click_to_reviews", "label": "Scroll to reviews when selected", "default": true},
    {"type": "text", "id": "empty_text", "label": "Empty state text", "default": "No reviews yet"},
    {"type": "text", "id": "write_text", "label": "Empty state link", "default": "Write a review"},
    {"type": "select", "id": "count_format", "label": "Review count format", "default": "words", "options": [{"value": "words", "label": "126 reviews"}, {"value": "compact", "label": "(126)"}]}
  ]
}
{% endschema %}
