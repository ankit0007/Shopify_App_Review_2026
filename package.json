    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.28",
    "nodemailer": "^10.0.12",
    "prisma": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
